# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.env

# macOS packaging build outputs (regenerated by packaging/macos/build.sh)
packaging/macos/build/
packaging/macos/dist/
assets/icon.icns
assets/icon.iconset/

# Arch packaging build outputs (regenerated by makepkg)
packaging/arch/pkg/
packaging/arch/src/
packaging/arch/*.pkg.tar.*

# Windows packaging build outputs (regenerated by packaging/windows/build.ps1)
packaging/windows/build/
packaging/windows/dist/
assets/icon.ico

# OS cruft
.DS_Store
Thumbs.db

# Editor/IDE
.vscode/
*.code-workspace
.idea/

# Claude Code personal settings
.claude/settings.local.json
